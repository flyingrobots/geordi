// Generated by scripts/contract-gate.mjs from scripts/lib/contract-gate/hash-harness.rs.template.
// Hashes example documents with the encoder functions of one tree's crate, built from that
// tree. Arguments are pairs of (encoder index, file path). Writes one JSON line per document:
// `hash` (schemas/geordi-contract-hash-harness/hash.schema.json) or `refusal`.

fn json_string(text: &str) -> String {
    let mut out = String::from("\"");
    for character in text.chars() {
        match character {
            '"' => out.push_str("\\\""),
            '\\' => out.push_str("\\\\"),
            c if (c as u32) < 0x20 => out.push_str(&format!("\\u{:04x}", c as u32)),
            c => out.push(c),
        }
    }
    out.push('"');
    out
}

fn report(encoder: &str, path: &str, result: Result<String, String>) {
    let (kind, field, value) = match result {
        Ok(hash) => ("hash", "hash", hash),
        Err(message) => ("refusal", "message", message),
    };
    println!(
        "{{\"_schema\":{{\"id\":\"geordi.contract_hash_harness.{kind}\",\"version\":\"1.0.0\"}},\"kind\":\"{kind}\",\"encoder\":{},\"path\":{},\"{field}\":{}}}",
        json_string(encoder),
        json_string(path),
        json_string(&value)
    );
}

fn main() {
    let args: Vec<String> = std::env::args().skip(1).collect();
    for pair in args.chunks(2) {
        let encoder = pair[0].as_str();
        let path = pair.get(1).map_or("", String::as_str);
        let source = match std::fs::read_to_string(path) {
            Ok(source) => source,
            Err(error) => {
                report(encoder, path, Err(error.to_string()));
                continue;
            }
        };
        let result: Result<String, String> = match encoder {
/*ENCODER_ARMS*/
            _ => Err(String::from("unknown encoder")),
        };
        report(encoder, path, result);
    }
}
