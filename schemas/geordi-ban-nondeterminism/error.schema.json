{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flyingrobots/geordi/schemas/geordi-ban-nondeterminism/error.schema.json",
  "title": "Error",
  "description": "A failed run: a usage error, a malformed allowlist or an internal fault. Written to stderr.",
  "x-schema-id": "geordi.ban_nondeterminism.error",
  "x-schema-version": "1.0.0",
  "x-stream": "stderr",
  "type": "object",
  "required": [
    "_schema",
    "kind",
    "code",
    "message"
  ],
  "additionalProperties": false,
  "properties": {
    "_schema": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "geordi.ban_nondeterminism.error"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "kind": {
      "const": "error"
    },
    "code": {
      "enum": [
        "GEORDI_E_BAN_NONDETERMINISM_USAGE",
        "GEORDI_E_BAN_NONDETERMINISM_MALFORMED_WAIVER",
        "GEORDI_E_BAN_NONDETERMINISM_INTERNAL"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1
    }
  }
}
