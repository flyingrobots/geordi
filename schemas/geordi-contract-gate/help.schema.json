{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flyingrobots/geordi/schemas/geordi-contract-gate/help.schema.json",
  "title": "Command help",
  "description": "What the command does and how to call it, and every error and violation code it can write. Written to stdout, followed by one schema line per output message type.",
  "x-schema-id": "geordi.contract_gate.help",
  "x-schema-version": "1.0.0",
  "type": "object",
  "required": [
    "_schema",
    "kind",
    "command",
    "summary",
    "usage",
    "options",
    "exitCodes",
    "errorCodes"
  ],
  "additionalProperties": false,
  "properties": {
    "_schema": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "geordi.contract_gate.help"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "kind": {
      "const": "help"
    },
    "command": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "usage": {
      "type": "string",
      "minLength": 1
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "flag",
          "description"
        ],
        "additionalProperties": false,
        "properties": {
          "flag": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exitCodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "meaning"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 0
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "stream",
          "meaning"
        ],
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "stream": {
            "enum": [
              "stdout",
              "stderr"
            ]
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
