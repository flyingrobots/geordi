{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/flyingrobots/geordi/schemas/geordi-bijou-wgpu-proof/result.schema.json",
  "title": "Result",
  "description": "Last line of a successful run. Written to stdout. `outcome` is the evidence level; only `gpu-probed` sets `hardwareGpuClaim`. `capability-refused` is a typed refusal and never a rendering pass. `frameComparison` is `match` when --expect-frame-sha256 was given and the frame read back hashes to it, `not-run` when it was given and no frame was read back, and `not-requested` otherwise. `obstruction` says why no hardware GPU claim is made, and is null for `gpu-probed`.",
  "x-schema-id": "geordi.bijou_wgpu_proof.result",
  "x-schema-version": "1.0.0",
  "type": "object",
  "required": [
    "_schema",
    "kind",
    "ok",
    "outcome",
    "hardwareGpuClaim",
    "frameRgbaSha256",
    "frameComparison",
    "obstruction"
  ],
  "additionalProperties": false,
  "properties": {
    "_schema": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "geordi.bijou_wgpu_proof.result"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    },
    "kind": {
      "const": "result"
    },
    "ok": {
      "const": true
    },
    "outcome": {
      "enum": [
        "gpu-probed",
        "software-probed",
        "capability-refused"
      ]
    },
    "hardwareGpuClaim": {
      "type": "boolean"
    },
    "frameRgbaSha256": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 64
    },
    "frameComparison": {
      "enum": [
        "match",
        "not-run",
        "not-requested"
      ]
    },
    "obstruction": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "code",
        "detail"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
